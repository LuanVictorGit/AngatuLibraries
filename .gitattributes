# Modelos de deploy: o Docker executa estes arquivos no Linux — CRLF quebra o shell.
templates/Dockerfile text eol=lf
templates/.dockerignore text eol=lf

# Build no JitPack e no GitHub Actions, também no Linux.
mvnw text eol=lf
mvnw.cmd text eol=crlf
.mvn/** text eol=lf
jitpack.yml text eol=lf
.github/** text eol=lf

# Scripts do E2E do Saveable: rodam no bash e no Docker, CRLF os quebra.
src/test/e2e/** text eol=lf
